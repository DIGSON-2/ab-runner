{
  "name": "ab-runner",
  "version": "1.0.32",
  "author": "DIGSON-2 <andranikbaldryan55@gmail.com>",
  "description": "AB Runner – настольное приложение для автоматизированной отправки HTTP-запросов с подстановкой данных из JSON-файлов.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:win": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DIGSON-2/ab-runner.git"
  },
  "build": {
    "appId": "com.digson.abrunner",
    "productName": "AB Runner",
    "artifactName": "AB-Runner-Setup-${version}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "DIGSON-2",
      "repo": "ab-runner",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.html",
      "renderer.js",
      "style.css",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    }
  },
  "keywords": [],
  "license": "ISC",
  "dependencies": {
    "axios": "^1.16.1",
    "codemirror": "^5.65.18",
    "electron-updater": "^6.8.3",
    "form-data": "^4.0.6"
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  }
}
