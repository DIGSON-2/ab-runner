{
  "name": "ab-runner",
  "version": "1.1.12",
  "author": "DIGSON-2 <andranikbaldryan55@gmail.com>",
  "description": "AB Runner – настольное приложение для автоматизированной отправки HTTP-запросов с подстановкой данных из JSON-файлов.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"*.config.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"*.config.js\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "release": "electron-builder --win --publish always"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DIGSON-2/ab-runner.git"
  },
  "build": {
    "appId": "com.digson.abrunner",
    "productName": "AB Runner",
    "artifactName": "AB-Runner-Setup-${version}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "DIGSON-2",
      "repo": "ab-runner",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.html",
      "style.css",
      "src/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    }
  },
  "keywords": [],
  "license": "ISC",
  "dependencies": {
    "axios": "^1.16.1",
    "codemirror": "^5.65.18",
    "electron-updater": "^6.8.3",
    "form-data": "^4.0.6"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "babel-jest": "^29.7.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2"
  }
}
